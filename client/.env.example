# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Secret key — SERVER ONLY, bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------- Stripe (payment gateway) ----------
STRIPE_SECRET_KEY=sk_live_or_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- AI Provider (anthropic | openai | mock) ----------
AI_PROVIDER=mock
AI_API_KEY=

# ---------- Backend API (server/) ----------
# Base URL of the server/ API. Local dev: http://localhost:4000
NEXT_PUBLIC_API_URL=https://bravestudio-backend.vercel.app

# ---------- Canva REST APIs (plantillas; server-only, ver docs/CANVA-DEV-SETUP.md) ----------
# Client ID y secret del portal: https://www.canva.com/developers/apps
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Redirect registrada en el portal (la misma en dev y prod):
#   dev:  http://127.0.0.1:3000/api/canva/oauth/callback
#   prod: https://bravestudio.app/api/canva/oauth/callback
CANVA_REDIRECT_URI=

# Clave de cifrado de tokens de integración (lib/crypto.ts) — ya se usa para
# Instagram/social; Canva la reutiliza. Genera 32+ chars aleatorios.
SOCIAL_TOKEN_SECRET=
